# Скопируйте этот файл в .env и впишите свой ключ. Файл .env в git не попадает.
# Нужен ключ только того провайдера, которым пользуетесь.

# Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# API DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq (Qwen 3.8 27B, бесплатный тариф): https://console.groq.com/keys
GROQ_API_KEY=
